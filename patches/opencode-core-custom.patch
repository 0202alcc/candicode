+function PipelinePhaseFeed(props: { text: string; message: AssistantMessage }) {
+  const { theme, syntax } = useTheme()
+
+  const rows = createMemo(() =>
+    props.text
+      .split("\n")
+      .map((line) => line.trimEnd())
+      .filter((line) => line.length > 0),
+  )
+
+  const modelLabel = createMemo(() => props.message.modelID || "unknown-model")
+  const parsed = createMemo(() => parsePipelineRows(rows()))
+
+  return (
+    <box paddingLeft={3} marginTop={1} gap={1}>
+      <For each={parsed().transientLogs}>
+        {(line) => (
+          <box
+            border={["left"]}
+            customBorderChars={SplitBorder.customBorderChars}
+            borderColor={theme.borderSubtle}
+            backgroundColor={theme.backgroundElement}
+            paddingTop={1}
+            paddingBottom={1}
+            paddingLeft={2}
+          >
+            <text fg={theme.textMuted}>{line}</text>
+          </box>
+        )}
+      </For>
+      <For each={parsed().cards}>
+        {(card) => (
+          <box
+            border={["left"]}
+            customBorderChars={SplitBorder.customBorderChars}
+            borderColor={card.color as any}
+            backgroundColor={theme.backgroundPanel}
+            paddingTop={1}
+            paddingBottom={1}
+            paddingLeft={2}
+          >
+            <code
+              filetype="markdown"
+              drawUnstyledText={false}
+              streaming={true}
+              syntaxStyle={syntax()}
+              content={formatPipelineCardBody(card.phase, card.output, card.status === "running" ? "---" : "None")}
+              fg={theme.text}
+            />
+            <text marginTop={1}>
+              <span style={{ fg: card.color as any }}>▣ </span>
+              <span style={{ fg: theme.text }}>{Locale.titlecase(card.phase)}</span>
+              <span style={{ fg: theme.textMuted }}> · {modelLabel()}</span>
+              <span style={{ fg: theme.textMuted }}> · {card.duration}</span>
+              <span style={{ fg: theme.textMuted }}> · [{card.status}]</span>
+            </text>
+          </box>
+        )}
+      </For>
+    </box>
+  )
+}
+
+type PipelinePhaseCard = {
+  phase: string
+  status: string
+  agent: string
+  color: string
+  duration: string
+  output?: unknown
+}
+
+type PipelineRows = {
+  cards: PipelinePhaseCard[]
+  transientLogs: string[]
+}
+
+function parsePipelineRows(lines: string[]): PipelineRows {
+  const order: string[] = []
+  const byPhase = new Map<string, PipelinePhaseCard>()
+  const transientLogs: string[] = []
+
+  const ensure = (phase: string) => {
+    const key = phase.trim()
+    if (!byPhase.has(key)) {
+      byPhase.set(key, {
+        phase: key,
+        status: "running",
+        agent: "unmapped",
+        color: "#94A3B8",
+        duration: "0ms",
+      })
+      order.push(key)
+    }
+    return byPhase.get(key)!
+  }
+
+  for (let index = 0; index < lines.length; index += 1) {
+    const line = lines[index]
+    const phaseMatch = line.match(
+      /^-\s+(?:\S+\s+)?([a-z_]+)\s+\[([a-z_]+)\]\s+agent=([^ ]+)(?:\s+color=(#[0-9A-Fa-f]{6}))?(?:\s+duration=([0-9.]+(?:ms|s|m)))?/,
+    )
+    if (!phaseMatch) continue
+    const phase = phaseMatch[1]
+    const status = phaseMatch[2]
+    const agent = phaseMatch[3]
+    const color = phaseMatch[4]
+    const duration = phaseMatch[5]
+    if (phase === "model_switch") {
+      const detailLine = lines[index + 1]?.trimStart()
+      if (detailLine && detailLine.startsWith("output:")) {
+        const detailRaw = detailLine.replace(/^output:\s*/, "")
+        const detailParsed = parsePipelineOutput(detailRaw)
+        transientLogs.push(`model switch: ${formatInlineValue(detailParsed)}`)
+        index += 1
+      } else {
+        transientLogs.push(`model switch: ${status}${duration ? ` · ${duration}` : ""}`)
+      }
+      continue
+    }
+    const card = ensure(phase)
+    card.agent = agent
+    if (color) card.color = color
+    if (status !== "output") {
+      card.status = status
+      if (duration) card.duration = duration
+      continue
+    }
+    const outputLine = lines[index + 1]?.trimStart()
+    if (outputLine && outputLine.startsWith("output:")) {
+      card.output = parsePipelineOutput(outputLine.replace(/^output:\s*/, ""))
+      index += 1
+    }
+  }
+
+  return { cards: order.map((phase) => byPhase.get(phase)!), transientLogs }
+}
+
+function parsePipelineOutput(raw: string): unknown {
+  try {
+    return JSON.parse(raw)
+  } catch {
+    return raw
+  }
+}
+
+function formatPipelineCardBody(phase: string, output: unknown, emptyValue: string): string {
+  const obj = output && typeof output === "object" && !Array.isArray(output) ? (output as Record<string, unknown>) : {}
+  switch (phase) {
+    case "intent":
+      return sectioned([
+        section("Composed the rewritten prompt", obj.rewritten_prompt, emptyValue),
+        section("Proposed success criteria", obj.success_criteria, emptyValue),
+        section("Identified target files", obj.target_files, emptyValue),
+        section("Proposed new files", obj.proposed_new_files, emptyValue),
+      ])
+    case "triage":
+      return sectioned([
+        section("Categorized task intensity", obj.intensity, emptyValue),
+        section("Categorized risk level", obj.risk_level, emptyValue),
+        section("Categorized scope size", obj.scope_size, emptyValue),
+        section("Identified task type", obj.task_type, emptyValue),
+      ])
+    case "requirements":
+      return sectioned([
+        section("Proposed acceptance criteria", obj.acceptance_criteria, emptyValue),
+        section("Non goals", obj.non_goals, emptyValue),
+        section("Open questions", obj.open_questions, emptyValue),
+      ])
+    case "versioning":
+      return sectioned([section("Chosen work branch", obj.work_branch, emptyValue)])
+    case "plan":
+      return sectioned([
+        section("Outlined steps", obj.steps, emptyValue),
+        section("Risk notes", obj.risk_notes, emptyValue),
+        section("Proposed test plans", obj.test_plan, emptyValue),
+      ])
+    case "code":
+      return sectioned([
+        section("Changes made", obj.changes, emptyValue),
+        section("Files edited", obj.file_edits, emptyValue),
+        section("Files touched", obj.files_touched, emptyValue),
+      ])
+    case "test":
+      return sectioned([
+        section("Tests added", obj.tests_added, emptyValue),
+        section("Checks to run", obj.checks_to_run, emptyValue),
+      ])
+    case "review":
+      return sectioned([
+        section("Review findings", obj.findings, emptyValue),
+        section("Required fixes", obj.required_fixes, emptyValue),
+        section("Risk summary", obj.risk_summary, emptyValue),
+      ])
+    case "docs":
+      return sectioned([
+        section("Changelog", obj.changelog, emptyValue),
+        section("Migration notes", obj.migration_notes, emptyValue),
+        section("Runbook delta", obj.runbook_delta, emptyValue),
+      ])
+    case "execute":
+      return sectioned([
+        section("Execution changes", obj.changes, emptyValue),
+        section("Tools used", obj.tools_used, emptyValue),
+      ])
+    case "verify":
+      return sectioned([
+        section("Verification checks", obj.checks, emptyValue),
+        section("Flaky quarantined", obj.flaky_quarantined, emptyValue),
+        section("Retry counts", obj.retry_counts, emptyValue),
+        section("Verification status", obj.status, emptyValue),
+      ])
+    case "human_checkpoints":
+      return sectioned([
+        section("Approved", obj.approved, emptyValue),
+        section("Missing checkpoints", obj.missing, emptyValue),
+      ])
+    case "gate_pre_merge":
+      return sectioned([
+        section("Allowed", obj.allowed, emptyValue),
+        section("Policy failures", obj.failures, emptyValue),
+      ])
+    case "finalize":
+      return sectioned([section("Outcome", obj.outcome, emptyValue), section("Summary", obj.summary, emptyValue)])
+    default:
+      return sectioned([section("Output", output, emptyValue)])
+  }
+}
+
+function section(title: string, value: unknown, emptyValue: string): string {
+  const lines = formatValueLines(value, emptyValue)
+  return `# ${title}:\n${lines.join("\n")}`
+}
+
+function sectioned(parts: string[]): string {
+  return parts.join("\n\n")
+}
+
+function formatValueLines(value: unknown, emptyValue: string): string[] {
+  if (value === undefined || value === null) return [emptyValue]
+  if (typeof value === "string") return [value.trim() ? value : emptyValue]
+  if (typeof value === "number" || typeof value === "boolean") return [String(value)]
+  if (Array.isArray(value)) {
+    if (value.length === 0) return [emptyValue]
+    return value.map((item) => `- ${formatInlineValue(item)}`)
+  }
+  if (typeof value === "object") {
+    const keys = Object.keys(value as Record<string, unknown>)
+    if (keys.length === 0) return [emptyValue]
+    return [JSON.stringify(value)]
+  }
+  return [String(value)]
+}
+
+function formatInlineValue(value: unknown): string {
+  if (value === undefined || value === null) return "None"
+  if (typeof value === "string") return value.trim() ? value : "None"
+  if (typeof value === "number" || typeof value === "boolean") return String(value)
+  return JSON.stringify(value)
+}
+
+function parsePipelineHeader(
+  text?: string,
+): {
+  status: string
+  phase: string
+} | undefined {
+  if (!text) return undefined
+  const first = text.split("\n")[0]?.trim()
+  if (!first) return undefined
+  const match = first.match(/^\[pipeline\]\s+status=([a-z_]+)\s+phase=([a-z_]+)/i)
+  if (!match) return undefined
+  return { status: match[1], phase: match[2] }
+}
+
+function computePipelineQueue(cards: PipelinePhaseCard[], currentPhase?: string): string[] {
+  const order = [
+    "intent",
+    "triage",
+    "requirements",
+    "versioning",
+    "plan",
+    "code",
+    "test",
+    "review",
+    "docs",
+    "execute",
+    "verify",
+    "human_checkpoints",
+    "gate_pre_merge",
+    "finalize",
+  ]
+  const statusByPhase = new Map(cards.map((card) => [card.phase, card.status]))
+  const idx = currentPhase ? Math.max(0, order.indexOf(currentPhase)) : 0
+  return order
+    .slice(idx)
+    .filter((phase) => statusByPhase.get(phase) !== "success")
+    .map((phase) => Locale.titlecase(phase))
+}
